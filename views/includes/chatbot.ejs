<button
  id="chat-toggle"
  class="chat-toggle"
  type="button"
  aria-label="Open WanderLust assistant"
  aria-controls="chat-panel"
  aria-expanded="false">
  <i class="fa-solid fa-comments" aria-hidden="true"></i>
  <span>Ask WanderLust</span>
</button>

<section id="chat-panel" class="chat-panel" aria-label="WanderLust assistant" hidden>
  <header class="chat-header">
    <div>
      <strong>WanderLust assistant</strong>
      <small>Ask about listings or using the portal</small>
    </div>
    <button id="chat-close" type="button" aria-label="Close assistant">×</button>
  </header>

  <div id="chat-messages" class="chat-messages" role="log" aria-live="polite">
    <div class="chat-message chat-message--assistant">
      Hi! What would you like to know?
    </div>
  </div>

  <form id="chat-form" class="chat-form">
    <label class="visually-hidden" for="chat-input">Your question</label>
    <input
      id="chat-input"
      name="message"
      type="text"
      maxlength="1000"
      placeholder="Ask a question..."
      autocomplete="off"
      required>
    <button id="chat-send" type="submit" aria-label="Send question">
      <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
    </button>
  </form>
</section>