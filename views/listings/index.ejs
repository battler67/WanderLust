<%layout("/layouts/BoilerPlate.ejs")-%>  

    <style>
        #filters{
            display:flex;
            flex-wrap:nowrap;
            align-items: center;   
            justify-content: center;
            gap: 2rem;    
            overflow-x: auto;
            /* horizontal-scroller */
            padding-top: 1rem;  
            align-items: center;
        }
        .filter{
            text-align:center;
            opacity:0.7;
            flex: 0 0 auto;  
        }
        .filter:hover{
            opacity: 1;
            color: #FF0000; /* Changes link color to red using a Hex code */
            cursor: pointer;
        }
        .filter p{
            font-size: 0.8rem;
        }
        .tax-info{
            display: none;
            /* there difference in display :none , visibility none */
        }
        .tax-toggle{
            border:1px solid black;
            border-radius:1rem;
            padding:0.8rem;
            height: 2.8rem;
            margin-bottom: 1rem;
            margin-left:2rem;
            display: flex;
            align-items:center;
            width:16rem;
        }
        .filter a {
        color: #FF0000; /* Changes link color to red using a Hex code */
        }
    </style>
    <body>
        <div id="filters" >
            <div class="filter">
                <div><a href="?category=Latest"><i class="fa-solid fa-fire"></i></a></div>
                <p>Latest</p> 
            </div>
            <div class="filter">
                <div> <a href="?category=Rooms"><i class="fa-solid fa-bed"></i></a></div>
                <p>Rooms</p>
            </div>
            <div class="filter">
                <div><a href="?category=Iconic Cities"><i class="fa-solid fa-mountain-city"></i> </a></div>
                <p>Iconic Cities</p>
            </div>
            <div class="filter">
                <div><a href="?category=Mountains"><i class="fa-solid fa-mountain"></i> </a></div>
                <p>Mountains</p>
            </div>
            <div class="filter">
                <div><a href="?category=Castles"><i class="fa-solid fa-chess-king"></i></a></div>
                <p>Castles</p>
            </div>
            <div class="filter">
                <div><a href="?category=Pools"><i class="fa-solid fa-person-swimming"></i></a></div>
                <p>Pools</p>
            </div>
            <div class="filter">
                <div><a href="?category=Camps"><i class="fa-solid fa-campground"></i></a></div>
                <p>Camps</p>
            </div>
            <div class="filter">
                <div><a href="?category=Farms"><i class="fa-solid fa-tractor"></i></a></div>
                <p>Farms</p>
            </div>
            <div class="filter">
                <div><a href="?category=Arctic"><i class="fa-solid fa-snowflake"></i></a></div>
                <p>Arctic</p>
            </div>

            <div class="filter">
                <div><a href="?category=Domes"><i class="fa-solid fa-landmark-dome"></i></a></div>
                <p>Domes</p>
            </div>
            <div class="filter">
                <div><a href="?category=Boats"><i class="fa-solid fa-ship"></i></a></div>
                <p>Boats</p>
            </div>

            <div class="tax-toggle">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
                </div>
            </div>
        </div>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
            <% for(let list of allListings){%>
                <div class="col md-4">
                <a href="/listings/<%= list._id %>" class="listing-link">
                    <div class="card col listing-card" style="width: 18rem;">
                        <img src="<%= list.image.url %>" class="card-img-top card-img-hover " alt="listing-image" style="height: 20rem;">
                        <div class="card-img-overlay d-flex flex-column justify-content-end card-img-hover">
                            <h5 class="card-title bg-dark bg-opacity-50 p-2 rounded">abcd</h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                <b>
                            <%= list.title%></b><br/>&#8377;
                                <%=  (list.price ?? 0).toLocaleString("en-IN")%> / night
                                <i class="tax-info">&nbsp; &nbsp;+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
                </div>
                <%}%>
        </div>
    </body>

    <script>
        let taxSwitch = document.getElementById("switchCheckDefault");
        taxSwitch.addEventListener("click",()=>{
            let taxInfo  = document.getElementsByClassName("tax-info");
            for(info of taxInfo){
                if(info.style.display == "inline"){
                    info.style.display = "none";
                }else{
                    info.style.display = "inline";
                }
            }
        });

    </script> 