<% layout("/layouts/BoilerPlate.ejs") -%>

<div class="row mt-4">
  <div class="col-8 offset-2">

    <h3>Edit Your Review</h3>

    <form 
      action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=PATCH" 
      method="POST" 
      class="needs-validation" 
      novalidate
    >

      <!-- ⭐ Rating -->
      <div class="mb-3 mt-3">
        <fieldset class="starability-slot">
          <legend>Rating:</legend>

          <% for(let i = 1; i <= 5; i++) { %>
            <input 
              type="radio" 
              id="rate<%= i %>" 
              name="review[rating]" 
              value="<%= i %>" 
              <%= review.rating === i ? "checked" : "" %>
            />
            <label for="rate<%= i %>" title="<%= i %> stars">
              <%= i %> star
            </label>
          <% } %>

        </fieldset>
      </div>

      <!-- 💬 Comment -->
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comment:</label>
        <textarea 
          name="review[comment]" 
          id="comment" 
          rows="3" 
          class="form-control" 
          required
        ><%= review.comment %></textarea>

        <div class="invalid-feedback">
          Please submit some comments
        </div>
      </div>

      <div class="d-flex gap-2">
        <button class="btn btn-dark">Update Review</button>
        <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary">
          Cancel
        </a>
      </div>

    </form>

  </div>
</div>
